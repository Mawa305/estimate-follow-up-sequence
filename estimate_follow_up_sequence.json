{
  "name": "Estimate Follow-up Sequence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        96
      ],
      "id": "2037a5e7-cf06-4a12-ac9b-a5988b41470b",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "estimates",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "pending"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        96
      ],
      "id": "8d609e45-97c0-4920-894c-6dd3a71ba1ab",
      "name": "Get many rows",
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n  const sentDate = new Date(data.sent_date);\n  const today = new Date();\n  const daysElapsed = Math.floor((today - sentDate) / (1000 * 60 * 60 * 24));\n  \n  const lastStage = data.last_follow_up_stage || 0;\n  let dueStage = null;\n  \n  if (daysElapsed >= 10 && lastStage < 10) {\n    dueStage = 10;\n  } else if (daysElapsed >= 5 && lastStage < 5) {\n    dueStage = 5;\n  } else if (daysElapsed >= 2 && lastStage < 2) {\n    dueStage = 2;\n  }\n  \n  if (dueStage !== null) {\n    results.push({\n      json: {\n        ...data,\n        days_elapsed: daysElapsed,\n        due_stage: dueStage\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "id": "78771c87-0210-47f9-b9bf-c162f43d983e",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Customer: {{ $json.customer_name }}\nEstimate amount: ${{ $json.estimate_amount }}\nFollow-up stage: Day {{ $json.due_stage }}\n\nWrite a short, friendly email follow-up about their pending HVAC estimate. If Day 2: gentle check-in. If Day 5: remind them of value/urgency (e.g. seasonal timing). If Day 10: polite final reminder before estimate expires."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        96
      ],
      "id": "d5e7ba4b-3216-4315-94c4-5698063ee216",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account 2"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "33c8e8cd-9cdb-467b-a1e5-04b7fb6119db",
              "name": "follow_up_message",
              "value": "={{ $json.output[0].content[0].text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1024,
        96
      ],
      "id": "9377ce97-97be-43cb-8058-cf4ca28f820c",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "sendTo": "={{ $('Get many rows').item.json.email }}",
        "subject": "={{ $('Code in JavaScript').item.json.due_stage === 10 ? 'Final reminder: Your estimate is expiring' : 'Quick follow-up on your estimate' }}",
        "emailType": "text",
        "message": "={{ $json.follow_up_message }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1248,
        96
      ],
      "id": "2971aa9e-4ac2-4582-9090-111d1e008192",
      "name": "Send a message",
      "retryOnFail": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account 3"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "estimates",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Code in JavaScript').item.json.id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "last_follow_up_stage",
              "fieldValue": "={{ $('Code in JavaScript').item.json.due_stage }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1472,
        0
      ],
      "id": "be10360d-ab9b-47ab-a577-570dde89feb8",
      "name": "Update a row",
      "credentials": {
        "supabaseApi": {
          "id": "REPLACE_SUPABASE_CREDENTIAL_ID",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Follow-up email failed for {{ $json.customer_name }} ({{ $json.email }}), estimate id {{ $json.id }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1472,
        192
      ],
      "id": "ec3cd25d-d0fc-4b48-827b-631af5d95100",
      "name": "Send a text message",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    }
  ],
